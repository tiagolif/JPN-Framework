{
  "version": "1.0.0",
  "status": "internal-review",
  "publication_authorized": false,
  "release_effect": "none",
  "purpose": "Define the complete internal commercial surface, its sources of truth, allowed local actions and release boundaries without authorizing publication or transaction.",
  "site_root": "commercial-site",
  "shared_stylesheet": "commercial-site/styles.css",
  "global_requirements": {
    "robots": "noindex,nofollow",
    "navigation": "relative-local-only",
    "external_urls_allowed": false,
    "transactional_cta_allowed": false,
    "pricing_allowed": false,
    "lead_capture_allowed": false,
    "tracking_allowed": false,
    "publication_allowed": false
  },
  "surfaces": [
    {
      "id": "portfolio-home",
      "path": "commercial-site/index.html",
      "type": "portfolio",
      "purpose": "Apresentar o ecossistema JPN e orientar para exploração interna do portfólio.",
      "source_contracts": [
        "docs/product-system/PRODUCT_PORTFOLIO_v1.json",
        "docs/product-system/PRODUCT_USAGE_ROUTES_v1.json",
        "docs/commercial/JPN_VISUAL_IDENTITY_v1.json"
      ],
      "allowed_actions": ["explore-catalog", "choose-product", "open-product-page"]
    },
    {
      "id": "portfolio-catalog",
      "path": "commercial-site/catalogo.html",
      "type": "catalog",
      "purpose": "Comparar os seis produtos em uma única superfície interna.",
