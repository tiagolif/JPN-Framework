{
  "name": "jpn-framework-sdk",
  "version": "0.3.0-draft.0",
  "description": "Reference TypeScript SDK for the JPN Framework (Jornada, Precisão, Narrativa).",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "prompt-engineering",
    "context-engineering",
    "rag",
    "ai-agents",
    "json-schema",
    "typescript",
    "jpn"
  ],
  "author": "Tiago Cunha de Souza",
  "license": "MIT"
}
