{
  "name": "jpn-framework-sdk",
  "version": "0.3.0-draft.0",
  "description": "Reference TypeScript SDK for the JPN Framework (Jornada, Precisão, Narrativa).",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "import": "./dist/browser/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:browser && npm run check:product-site && npm run check:prompt-builder-presets && npm run check:prompt-builder-custom-presets && npm run check:prompt-builder-workspaces && npm run check:prompt-builder-recovery && npm run check:prompt-builder-staging && npm run check:product-consistency && npm run check:jpn-business-links && npm run check:jpn-business-print-candidate && npm run check:core-editorial-hygiene && npm run check:core-terminology && npm run check:product-portfolio && npm run check:product-release-status && npm run check:product-readiness-report && npm run check:pro-kit && npm run check:pro-kit-manifest && npm run check:pro-kit-staging && npm run check:visual-assets && npm run check:visual-bounds && npm run check:editorial-release && npm run check:commercial-copy && npm run check:commercial-site && npm run check:commercial-navigation && npm run check:commercial-accessibility && npm run check:commercial-contrast && npm run check:gestao-facil-model && npm run check:gestao-facil-binary && npm run report:release-readiness && npm run build:visual-review && npm run build:editorial-print && npm run build:jpn-business-print-candidate && npm run stage:prompt-builder",
    "build:browser": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/browser/index.js && node scripts/check-browser-build.mjs && node scripts/check-browser-parity.mjs",
    "check:browser:parity": "node scripts/check-browser-parity.mjs",
    "check:product-site": "node scripts/check-product-site-sdk.mjs",
    "check:prompt-builder-presets": "node scripts/check-prompt-builder-presets.mjs",
    "check:prompt-builder-custom-presets": "node scripts/check-prompt-builder-custom-presets.mjs",
    "check:prompt-builder-workspaces": "node scripts/check-prompt-builder-workspaces.mjs",
    "check:prompt-builder-recovery": "node scripts/check-prompt-builder-recovery.mjs",
    "check:prompt-builder-staging": "node scripts/stage-prompt-builder-offline.mjs --check",
    "check:product-consistency": "node scripts/check-product-consistency.mjs",
    "check:jpn-business-links": "node scripts/check-jpn-business-links.mjs",
    "check:jpn-business-print-candidate": "node scripts/build-jpn-business-print-candidate.mjs --check",
    "check:core-editorial-hygiene": "node scripts/check-core-editorial-hygiene.mjs",
    "check:core-terminology": "node scripts/check-core-terminology.mjs",
    "check:product-portfolio": "node scripts/check-product-portfolio.mjs",
    "check:product-release-status": "node scripts/check-product-release-status.mjs",
    "check:product-readiness-report": "node scripts/report-product-readiness.mjs --check",
    "check:pro-kit": "node scripts/check-pro-kit-release.mjs",
    "check:pro-kit-manifest": "node scripts/check-pro-kit-manifest.mjs",
    "check:pro-kit-staging": "node scripts/stage-pro-kit.mjs --check",
    "check:visual-assets": "node scripts/check-visual-assets.mjs",
    "check:visual-bounds": "node scripts/check-visual-bounds.mjs",
    "check:editorial-release": "node scripts/check-editorial-release.mjs",
    "check:commercial-copy": "node scripts/check-commercial-copy.mjs",
    "check:commercial-site": "node scripts/check-commercial-site.mjs",
    "check:commercial-navigation": "node scripts/check-commercial-navigation.mjs",
    "check:commercial-accessibility": "node scripts/check-commercial-accessibility.mjs",
    "check:commercial-contrast": "node scripts/check-commercial-contrast.mjs",
    "check:gestao-facil-model": "node scripts/check-gestao-facil-model.mjs",
    "check:gestao-facil-binary": "node scripts/check-gestao-facil-binary.mjs",
    "stage:pro-kit": "node scripts/stage-pro-kit.mjs",
    "stage:prompt-builder": "node scripts/stage-prompt-builder-offline.mjs",
    "report:release-readiness": "node scripts/report-release-readiness.mjs",
    "report:product-readiness": "node scripts/report-product-readiness.mjs",
    "build:visual-review": "node scripts/build-visual-review-gallery.mjs",
    "build:editorial-print": "node scripts/build-editorial-print-staging.mjs",
    "build:jpn-business-print-candidate": "node scripts/build-jpn-business-print-candidate.mjs",
    "export:editorial-pdfs": "node scripts/export-editorial-pdf-candidates.mjs",
    "review:editorial-pdfs": "node scripts/build-editorial-pdf-review-gallery.mjs",
    "eval:score": "node scripts/score-evals.mjs",
    "eval:blind": "node scripts/build-blind-eval-packet.mjs",
    "eval:report": "node scripts/build-evidence-report.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "prompt-engineering",
    "context-engineering",
    "rag",
    "ai-agents",
    "json-schema",
    "typescript",
    "jpn"
  ],
  "author": "Tiago Cunha de Souza",
  "license": "MIT"
}
